[0.293787, "o", "\u001b[32m╭─\u001b[0m\u001b[32m────────────────────────────\u001b[0m\u001b[32m ✨ Local Setup ✨ \u001b[0m\u001b[32m─────────────────────────────\u001b[0m\u001b[32m─╮\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1;36mWelcome to EnvShield Setup\u001b[0m                                                   \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m                                                                              \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m This wizard will help you create your local \u001b[35m.env\u001b[0m file.                       \u001b[32m│\u001b[0m\r\n\u001b[32m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.295106, "o", "\r\n\u001b[1mReading variables from \u001b[0m\u001b[1;36m.env.example\u001b[0m\u001b[1;33m...\u001b[0m\r\n"]
